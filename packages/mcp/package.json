{
  "name": "@playbooks/mcp",
  "version": "0.17.0",
  "mcpName": "xyz.playbooks/mcp-server",
  "description": "MCP wrapper around the Playbooks CLI.",
  "homepage": "https://docs.playbooks.ai",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "playbooks-mcp": "dist/index.cjs"
  },
  "scripts": {
    "start": "vite build --mode development --minify false --watch",
    "build": "vite build --mode production --minify true && npm run build:ts",
    "build:ts": "tsc --project tsconfig.json --noEmit false && tsc-alias",
    "build:dry": "npm run typecheck",
    "clean": "npm run format:fix",
    "format": "prettier --check src",
    "format:fix": "prettier --write src",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "serve": "node dist/index.cjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "@playbooks/cli": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.0",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-complete": "1.4.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "prettier": "3.8.1",
    "tsc-alias": "1.8.16",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vite": "8.0.0",
    "vite-plugin-size": "0.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playbooks-hq/playbooks-clients.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/playbooks-hq/playbooks-clients/issues"
  },
  "author": {
    "name": "Playbooks",
    "email": "support@playbooks.ai",
    "url": "https://github.com/playbooks-hq"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs"
    }
  }
}
