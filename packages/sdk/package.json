{
  "name": "@playbooks/sdk",
  "version": "1.0.0",
  "description": "Typed server-side client for the Playbooks platform API.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playbooks-hq/playbooks-clients.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/playbooks-hq/playbooks-clients/issues"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && node scripts/cjs-types.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check src"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-complete": "1.4.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "13.24.0",
    "prettier": "3.8.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vite": "8.0.0",
    "@types/node": "24.0.14"
  }
}
