# Shared CLI/MCP runtime configuration; copy to .env and load explicitly.
# Use browser sign-in or provide a scoped developer API key for this API origin.
PLAYBOOKS_API_URL=https://api.playbooks.dev:8080
# Optional override for a custom sign-in issuer.
PLAYBOOKS_AUTH_URL=
PLAYBOOKS_TOKEN=
# Workspace selection remains in CLI configuration or --workspace.
# SDK callers pass apiKey and baseUrl explicitly; SDK does not load this file.
