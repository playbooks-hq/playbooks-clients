{
  "name": "@playbooks/cli",
  "description": "A simple CLI for the Playbooks project.",
  "homepage": "https://docs.playbooks.xyz",
  "version": "0.3.1",
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "bin": {
    "playbooks": "dist/index.cjs.js"
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "Playbooks",
    "email": "support@playbooks.xyz",
    "url": "https://github.com/playbooks-xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playbooks-xyz/playbooks-cli.git"
  },
  "bugs": {
    "url": "https://github.com/playbooks-xyz/playbooks-cli/issues"
  },
  "scripts": {
    "start": "vite build --mode development --minify false --watch --sourcemap",
    "build": "vite build --mode production --minify false",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier src",
    "format:fix": "prettier --write src",
    "clean": "npm run lint:fix && npm run format:fix",
    "commit": "scripts/commit.sh",
    "deploy": "scripts/deploy.sh",
    "git": "git push --tags",
    "test": "jest",
    "prepare": "husky"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "enquirer": "^2.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "fs-extra": "^11.2.0",
    "https": "^1.0.0",
    "ora": "^5.4.1",
    "sade": "^1.8.1",
    "superagent": "^9.0.2",
    "unzip-stream": "^0.3.4",
    "vite-plugin-dts": "^3.9.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.1",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@typescript-eslint/eslint-plugin": "^5.46.0",
    "@typescript-eslint/parser": "^5.46.0",
    "@vitejs/plugin-react": "^3.0.0",
    "dts-bundle-generator": "^7.1.0",
    "eslint": "^8.29.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-eqeqeq-fix": "^1.0.3",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "prettier": "^2.8.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.4.1",
    "typescript": "^4.9.4",
    "typescript-transform-paths": "^3.4.7",
    "vite": "^4.0.0"
  }
}
