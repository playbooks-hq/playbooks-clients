{
  "name": "@playbooks/cli",
  "description": "A simple CLI for the Playbooks project.",
  "homepage": "https://docs.playbooks.xyz",
  "version": "0.3.6",
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "bin": {
    "playbooks": "dist/index.cjs.js"
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "Playbooks",
    "email": "support@playbooks.xyz",
    "url": "https://github.com/playbooks-xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playbooks-xyz/playbooks-cli.git"
  },
  "scripts": {
    "dev": "vite build --mode development --minify false --watch",
    "start": "vite build --mode development --minify false",
    "build": "vite build --mode production --minify true && npm run build:ts",
    "build:ts": "tsc --project tsconfig.json --noEmit false && tsc-alias",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier src",
    "format:fix": "prettier --write src",
    "clean": "npm run lint:fix && npm run format:fix",
    "commit": "scripts/commit.sh",
    "deploy": "scripts/deploy.sh",
    "git": "git push --tags",
    "test": "jest",
    "prepare": "husky"
  },
  "dependencies": {
    "@playbooks/normalizers": "^0.0.1",
    "@playbooks/serializers": "^0.0.1",
    "archiver": "^7.0.1",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "enquirer": "^2.4.1",
    "fs-extra": "^11.2.0",
    "https": "^1.0.0",
    "ora": "^5.4.1",
    "sade": "^1.8.1",
    "superagent": "^9.0.2",
    "unzip-stream": "^0.3.4",
    "vite-plugin-dts": "^3.9.1"
  },
  "devDependencies": {
    "@playbooks/configs": "^0.0.2",
    "@types/jest": "^29.5.1",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tslib": "^2.4.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
