# Only the approved existing local stack. No fallback to production or .env.
CLIENTS_TEST_API_URL=https://api.playbooks.dev:8000
CLIENTS_TEST_APPROVED=false
CLIENTS_TEST_SERVER_ROOT=../playbooks-server
# Local setup/funding only; never passed to the client processes.
CLIENTS_TEST_ADMIN_EMAIL=
CLIENTS_TEST_ADMIN_PASSWORD=
# Absolute path to your trusted local CA, if required. Never disable TLS verification.
NODE_EXTRA_CA_CERTS=
